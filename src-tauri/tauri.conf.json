{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lunmia Memory",
  "version": "0.1.0",
  "identifier": "com.lunmia.memory",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Lunmia Memory",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "url": "/",
        "visible": true,
        "center": true,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true
      },
      {
        "label": "captura",
        "title": "Captura rápida",
        "width": 620,
        "height": 200,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": true,
        "center": true,
        "url": "/captura",
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Captura ideas con IA local en tu Mac",
    "longDescription": "Lunmia Memory captura ideas, notas, recordatorios y capturas de pantalla en menos de tres segundos y las clasifica con modelos que corren en tu Mac. Nada sale a la nube.",
    "copyright": "© 2026 Yonatan",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {}
}
