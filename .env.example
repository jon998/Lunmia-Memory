# Copia este archivo como `.env.local` en la raíz del proyecto y llena tu key.
# `.env.local` NO se sube a git (ya está en .gitignore).
# Se carga automáticamente al arrancar `pnpm tauri dev`.
# `pnpm tauri build` incrusta estas variables en el binario (fallback del .app).
# También puedes copiar este archivo a:
#   ~/Library/Application Support/Lunmia Memory/.env

# ─── Proveedor del LLM ─────────────────────────────────────────────────
# Opciones: ollama (default, local) | dashscope (Qwen cloud, pruebas)
LUNMIA_LLM_PROVIDER=dashscope

# ─── Alibaba DashScope (sólo si PROVIDER=dashscope) ────────────────────
# Consigue tu key en: https://bailian.console.alibabacloud.com/
LUNMIA_LLM_API_KEY=sk-pon-aqui-tu-api-key

# Modelo del clasificador (opcional, default: qwen-flash)
# Alternativas: qwen-flash, qwen-turbo, qwen-plus, qwen3-max
LUNMIA_LLM_MODEL=qwen-flash

# Modelo de embeddings (opcional, default: text-embedding-v3)
LUNMIA_EMBED_MODEL=text-embedding-v3

# Endpoint (opcional, default internacional)
# Para China mainland: https://dashscope.aliyuncs.com/compatible-mode/v1
# LUNMIA_LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# ─── Ollama local (sólo si PROVIDER=ollama) ────────────────────────────
# LUNMIA_OLLAMA_HOST=http://127.0.0.1:11434
# LUNMIA_LLM_MODEL=qwen2.5:3b
# LUNMIA_EMBED_MODEL=bge-m3

# ─── Log de llamadas al LLM ────────────────────────────────────────────
# Ruta: ~/Library/Application Support/Lunmia Memory/logs/llm.jsonl
# 1 = escribe cada llamada (prompt+respuesta+latencia) al archivo. Default: 1.
# LUNMIA_LLM_LOG=1
